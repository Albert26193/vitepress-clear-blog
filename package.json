{
    "name": "blog-monorepo",
    "private": true,
    "version": "0.1.0",
    "description": "A VitePress blog monorepo",
    "type": "module",
    "scripts": {
        "clean": "pnpm -r --stream clean",
        "clean:testbed": "pnpm -F=testbed clean",
        "build": "pnpm clean && pnpm build:packages",
        "build:packages": "pnpm build:plugins && pnpm build:system && pnpm build:test-packages",
        "build:plugins": "pnpm -r --filter './packages/vitepress-plugin-*' build",
        "build:system": "pnpm -r --workspace-concurrency=1 --filter vitepress-theme-link --filter create-vitepress-theme-link build",
        "build:test-packages": "pnpm -r --workspace-concurrency=1 --filter demo --filter testbed build",
        "build:unocss": "unocss --config ./packages/theme/uno.config.ts \"../theme/src/**/*.{vue,html,md,svelte,ts,jsx,tsx}\" --out-file ./sites/testbed/.vitepress/theme/styles/uno.css",
        "build:testbed": "pnpm -F=testbed build",
        "dev": "pnpm --stream '/(dev:packages|dev:testbed)/'",
        "dev:testbed": "pnpm -F=testbed dev",
        "dev:packages": "pnpm build:plugins && pnpm --parallel dev",
        "dev:unocss": "unocss --config ./packages/theme/uno.config.ts \"../theme/src/**/*.{vue,html,md,svelte,ts,jsx,tsx}\" --out-file ./sites/testbed/.vitepress/theme/styles/uno.css --watch",
        "test": "pnpm test:unit && pnpm test:e2e",
        "test:unit": "pnpm -r test:unit",
        "test:e2e": "pnpm -F vitepress-theme-link test:e2e",
        "test:ui": "pnpm -r --stream '/(test:ui)/'",
        "lint": "eslint --fix './packages/**/*.{ts,tsx,js,jsx,vue}' './sites/**/*.{ts,tsx,js,jsx,vue}'",
        "check-commit": "commitlint",
        "typecheck": "vue-tsc -b tsconfig.typecheck.json",
        "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
        "preview:testbed": "pnpm -F=testbed preview",
        "format": "prettier --write .",
        "prepare": "husky"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.0",
        "@commitlint/config-conventional": "^20.5.0",
        "@eslint/js": "^10.0.1",
        "@iconify-json/carbon": "^1.2.16",
        "@playwright/test": "^1.59.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^25.5.0",
        "@unocss/cli": "^66.6.7",
        "@unocss/preset-icons": "66.6.7",
        "@vitejs/plugin-vue": "^6.0.3",
        "@vitest/coverage-v8": "^4.1.6",
        "commitlint": "^20.5.0",
        "conventional-changelog": "^7.2.0",
        "cpx2": "^8.0.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.1.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-vue": "^10.8.0",
        "globals": "^17.0.0",
        "happy-dom": "^20.9.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "rimraf": "^6.1.3",
        "tsup": "^8.5.1",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.57.2",
        "unocss": "66.6.7",
        "vite": "7.3.1",
        "vitest": "^4.1.6",
        "vue-eslint-parser": "^10.4.0",
        "vue-tsc": "^3.2.2"
    },
    "lint-staged": {
        "*.{js,ts,vue,json}": [
            "prettier --write",
            "eslint --fix"
        ]
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=9.0.0"
    },
    "pnpm": {
        "peerDependencyRules": {
            "ignoreMissing": [
                "typescript"
            ]
        }
    }
}
