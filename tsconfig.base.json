{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [".vitepress/*"],
      "~/*": ["./*"],
      "vitepress-theme-link": ["./packages/theme/src/index.ts"],
      "vitepress-theme-link/node": ["./packages/theme/src/utils/node/index.ts"],
      "vitepress-theme-link/styles": ["./packages/theme/src/styles/index.scss"],
      "vitepress-theme-link/uno.config": ["./packages/theme/uno.config.ts"],
      "vitepress-theme-link/*": ["./packages/theme/src/*"],
      "vitepress-plugin-analyzer": [
        "./packages/vitepress-plugin-analyzer/src/node/index.ts"
      ],
      "vitepress-plugin-analyzer/client": [
        "./packages/vitepress-plugin-analyzer/src/client/index.ts"
      ],
      "vitepress-plugin-analyzer/types": [
        "./packages/vitepress-plugin-analyzer/types/index.d.ts"
      ],
      "vitepress-plugin-callouts": [
        "./packages/vitepress-plugin-callouts/src/node/index.ts"
      ],
      "vitepress-plugin-callouts/styles": [
        "./packages/vitepress-plugin-callouts/src/styles/index.css"
      ],
      "vitepress-plugin-codeblock-fold": [
        "./packages/vitepress-plugin-codeblock-fold/src/index.ts"
      ],
      "vitepress-plugin-codeblock-fold/style.css": [
        "./packages/vitepress-plugin-codeblock-fold/src/style.css"
      ],
      "vitepress-plugin-config": [
        "./packages/vitepress-plugin-config/src/index.ts"
      ],
      "vitepress-plugin-details-block": [
        "./packages/vitepress-plugin-details-block/src/index.ts"
      ],
      "vitepress-plugin-hashtag": [
        "./packages/vitepress-plugin-hashtag/src/node/index.ts"
      ],
      "vitepress-plugin-hashtag/client": [
        "./packages/vitepress-plugin-hashtag/src/client/index.ts"
      ],
      "vitepress-plugin-hashtag/client.css": [
        "./packages/vitepress-plugin-hashtag/src/client/hashtag.css"
      ],
      "vitepress-plugin-shortlink": [
        "./packages/vitepress-plugin-shortlink/src/node/index.ts"
      ],
      "vitepress-plugin-shortlink/client": [
        "./packages/vitepress-plugin-shortlink/src/client/index.ts"
      ],
      "vitepress-plugin-shortlink/client.css": [
        "./packages/vitepress-plugin-shortlink/src/client/shortlink.css"
      ]
    }
  }
}
