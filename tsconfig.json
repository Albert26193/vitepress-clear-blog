{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "moduleResolution": "node",
    "paths": {
      "@/*": [".vitepress/*"],
      "~/*": ["./*"],
      "vitepress-clear-blog/*": ["./packages/theme/src/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.d.ts",
    "packages/**/*.vue",
    "sites/**/*.ts",
    "sites/**/*.d.ts",
    "sites/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/vite.config.ts",
    "**/vitest.config.ts"
  ]
}
