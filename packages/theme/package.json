{
  "name": "vitepress-theme-link",
  "version": "0.1.0",
  "description": "A clean, customizable blog theme for VitePress",
  "author": "Albert26193",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Albert26193/vitepress-theme-link",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Albert26193/vitepress-theme-link.git",
    "directory": "packages/theme"
  },
  "bugs": {
    "url": "https://github.com/Albert26193/vitepress-theme-link/issues"
  },
  "keywords": [
    "vitepress",
    "theme",
    "blog",
    "vue"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/types/types.d.ts",
      "import": "./src/index.ts"
    },
    "./node": {
      "types": "./lib/node/index.d.ts",
      "import": "./lib/node/index.mjs",
      "require": "./lib/node/index.js",
      "default": "./lib/node/index.js"
    },
    "./styles": "./lib/styles/index.scss",
    "./types": "./src/types/types.d.ts",
    "./uno.config": "./uno.config.ts"
  },
  "files": [
    "lib",
    "src",
    "uno.config.ts"
  ],
  "scripts": {
    "dev": "pnpm '/(tsup|copy):watch/'",
    "build": "pnpm run clean && pnpm run tsup && pnpm run copy",
    "clean": "rimraf --glob ./lib",
    "copy": "cpx \"src/**/*.{d.ts,vue,css,scss,jpg,png,woff2}\" lib",
    "copy:watch": "cpx \"src/**/*.{d.ts,vue,css,scss,jpg,png,woff2}\" lib -w",
    "tsup": "tsup --config tsup.config.ts",
    "tsup:watch": "tsup --config tsup.config.ts --watch -- -c",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@iconify-json/carbon": "^1.2.16",
    "@vueuse/core": "^14.1.0",
    "beautiful-mermaid": "^1.1.3",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dayjs": "^1.11.13",
    "gray-matter": "^4.0.3",
    "heti": "^0.9.6",
    "lodash": "^4.17.21",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mathjax3": "^4.3.2",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-wikilinks": "^1.4.0",
    "mermaid": "^11.12.2",
    "photoswipe": "^5.4.4",
    "smol-toml": "^1.6.0",
    "vitepress-plugin-analyzer": "workspace:*",
    "vitepress-plugin-callouts": "workspace:*",
    "vitepress-plugin-codeblock-fold": "workspace:*",
    "vitepress-plugin-config": "workspace:*",
    "vitepress-plugin-details-block": "workspace:*",
    "vitepress-plugin-hashtag": "workspace:*",
    "vitepress-plugin-image-dimension": "workspace:*",
    "vitepress-plugin-llms": "^1.10.0",
    "vitepress-plugin-rss": "^0.4.2"
  },
  "peerDependencies": {
    "sass": "^1.0.0",
    "unocss": "^66.0.0",
    "vitepress": "^1.5.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.23",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^25.0.6",
    "@vitest/coverage-v8": "^4.1.6",
    "@vue/compiler-sfc": "^3.5.26",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "markdown-link-extractor": "^4.0.3",
    "sass": "^1.97.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
