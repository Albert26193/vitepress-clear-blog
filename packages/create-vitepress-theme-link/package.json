{
  "name": "create-vitepress-theme-link",
  "version": "0.1.0",
  "type": "module",
  "description": "Scaffold a VitePress Theme Link project with one command",
  "bin": {
    "create-vitepress-theme-link": "./bin/create-vitepress-theme-link.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
