{
  "name": "vitepress-plugin-config",
  "version": "0.1.0",
  "description": "VitePress plugin for TOML-based theme configuration",
  "author": "Albert26193",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Albert26193/vitepress-theme-link",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Albert26193/vitepress-theme-link.git",
    "directory": "packages/vitepress-plugin-config"
  },
  "bugs": {
    "url": "https://github.com/Albert26193/vitepress-theme-link/issues"
  },
  "keywords": [
    "vitepress",
    "plugin",
    "config",
    "toml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "dev": "tsup --config tsup.config.ts --watch",
    "build": "tsup --config tsup.config.ts",
    "clean": "rimraf lib",
    "test:unit": "vitest run"
  },
  "peerDependencies": {
    "vitepress": "^1.5.0"
  },
  "dependencies": {
    "smol-toml": "^1.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vite": "^7.3.1",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
