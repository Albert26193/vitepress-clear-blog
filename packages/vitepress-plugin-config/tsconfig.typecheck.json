{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "../../.tsbuild/types/vitepress-plugin-config",
    "tsBuildInfoFile": "../../.tsbuild/vitepress-plugin-config.tsbuildinfo"
  },
  "include": [
    "../../types/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "test/**/*.ts"
  ],
  "exclude": ["node_modules", "lib", "dist", "test-results", "coverage"]
}
