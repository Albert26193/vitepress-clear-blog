{
  "name": "vitepress-plugin-codeblock-fold",
  "version": "0.1.0",
  "description": "A VitePress plugin to fold long code blocks",
  "author": "Albert26193",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./style.css": "./lib/style.css"
  },
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test:unit": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "jsdom": "^26.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vue": "^3.5.26"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
