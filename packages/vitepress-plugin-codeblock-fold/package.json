{
  "name": "vitepress-plugin-codeblock-fold",
  "version": "0.1.0-beta.11",
  "description": "VitePress plugin to fold long code blocks",
  "author": "Albert26193",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Albert26193/vitepress-theme-link",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Albert26193/vitepress-theme-link.git",
    "directory": "packages/vitepress-plugin-codeblock-fold"
  },
  "bugs": {
    "url": "https://github.com/Albert26193/vitepress-theme-link/issues"
  },
  "keywords": [
    "vitepress",
    "plugin",
    "codeblock",
    "fold"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./style.css": "./lib/style.css"
  },
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "dev": "tsup --watch --onSuccess \"pnpm run copy:css\"",
    "clean": "rimraf lib",
    "tsup": "tsup --config tsup.config.ts",
    "copy:css": "node -e \"require('node:fs').mkdirSync('lib',{recursive:true});require('node:fs').copyFileSync('src/style.css','lib/style.css')\"",
    "build": "pnpm run clean && pnpm run tsup && pnpm run copy:css",
    "test:unit": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "vitepress": "^1.5.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.35"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
