{
  "name": "vitepress-plugin-details-block",
  "version": "0.1.0-beta.9",
  "description": "A customizable details block component for VitePress",
  "author": "Albert26193",
  "license": "MIT",
  "homepage": "https://github.com/Albert26193/vitepress-theme-link",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Albert26193/vitepress-theme-link.git",
    "directory": "packages/vitepress-plugin-details-block"
  },
  "bugs": {
    "url": "https://github.com/Albert26193/vitepress-theme-link/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.umd.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.umd.js"
    },
    "./style.css": "./lib/index.css"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.json",
    "dev": "vite build --watch",
    "test:unit": "vitest run"
  },
  "keywords": [
    "vitepress",
    "plugin",
    "details",
    "component"
  ],
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.9.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue": "^3.5.35",
    "vue-tsc": "^3.3.3"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
