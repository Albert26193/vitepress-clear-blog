{
  "name": "vitepress-plugin-details-block",
  "version": "0.1.0",
  "description": "A customizable details block component for VitePress",
  "author": "Albert26193",
  "license": "MIT",
  "homepage": "https://github.com/Albert26193/vitepress-theme-link",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Albert26193/vitepress-theme-link.git",
    "directory": "packages/vitepress-plugin-details-block"
  },
  "bugs": {
    "url": "https://github.com/Albert26193/vitepress-theme-link/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.umd.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.umd.js"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.json",
    "dev": "vite build --watch",
    "test:unit": "vitest run"
  },
  "keywords": [
    "vitepress",
    "plugin",
    "details",
    "component"
  ],
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.2",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.9.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.2",
    "vue": "^3.5.26",
    "vue-tsc": "^3.2.2"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
