{
  "name": "vitepress-plugin-callouts",
  "version": "0.1.0-beta.11",
  "description": "VitePress plugin for Obsidian-style callout blocks",
  "author": "Albert26193",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Albert26193/vitepress-theme-link",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Albert26193/vitepress-theme-link.git",
    "directory": "packages/vitepress-plugin-callouts"
  },
  "bugs": {
    "url": "https://github.com/Albert26193/vitepress-theme-link/issues"
  },
  "keywords": [
    "vitepress",
    "plugin",
    "callout",
    "admonition"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/node/index.d.ts",
      "import": "./lib/node/index.js",
      "require": "./lib/node/index.cjs"
    },
    "./styles": "./lib/styles/index.css"
  },
  "main": "lib/node/index.cjs",
  "module": "lib/node/index.js",
  "types": "lib/node/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "dev": "pnpm '/(tsup|copy):watch/'",
    "copy": "cpx -v \"src/**/*.{d.ts,vue,css,scss,jpg,png,woff2}\" lib",
    "copy:watch": "cpx -v \"src/**/*.{d.ts,vue,css,scss,jpg,png,woff2}\" lib -w",
    "tsup": "tsup --config tsup.config.ts",
    "tsup:watch": "tsup --config tsup.config.ts --watch -- -c",
    "clean": "rimraf lib",
    "build": "pnpm run clean && pnpm run tsup && pnpm run copy",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "markdown-it": "^14.2.0"
  },
  "peerDependencies": {
    "vitepress": "^1.5.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
