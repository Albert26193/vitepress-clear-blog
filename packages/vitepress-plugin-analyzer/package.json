{
  "name": "vitepress-plugin-analyzer",
  "version": "0.1.0-beta.1",
  "description": "VitePress plugin for global site analytics and backlink graph",
  "author": "Albert26193",
  "license": "MIT",
  "homepage": "https://github.com/Albert26193/vitepress-theme-link",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Albert26193/vitepress-theme-link.git",
    "directory": "packages/vitepress-plugin-analyzer"
  },
  "bugs": {
    "url": "https://github.com/Albert26193/vitepress-theme-link/issues"
  },
  "keywords": [
    "vitepress",
    "plugin",
    "analyzer",
    "backlink"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "import": "./lib/client.js",
      "require": "./lib/client.cjs"
    },
    "./types": {
      "types": "./types/index.d.ts"
    }
  },
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "types"
  ],
  "scripts": {
    "dev": "tsup --config tsup.config.ts --watch",
    "build": "tsup --config tsup.config.ts",
    "clean": "rimraf lib",
    "test:unit": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.2.0",
    "neverthrow": "^8.2.0"
  },
  "peerDependencies": {
    "vitepress": "^1.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.1",
    "vite": "^8.0.16"
  }
}
